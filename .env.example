# Database connection (SQLite for local dev or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication secret
JWT_SECRET="your_strong_jwt_secret_here"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Object Storage (S3 / Cloudflare R2 / MinIO) or "local"
STORAGE_PROVIDER="local"
S3_BUCKET_NAME="rentoby-storage"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Razorpay Payments (Server-side verified)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
